# ── Application ───────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# ── Database (SQLite for dev, PostgreSQL / SQL Server for prod) ──
DATABASE_URL=sqlite+aiosqlite:///./ppe_detection.db
# DATABASE_URL=postgresql+asyncpg://ppe:ppe@db:5432/ppe_detection
# DATABASE_URL=mssql+aioodbc://user:password@localhost:1433/nexora_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Authentication & Bootstrap Admin ──────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=admin123
BOOTSTRAP_SECTOR=both

# ── Source Security (SSRF / Path Traversal Protection) ────────
ALLOWED_RTSP_PREFIXES=
ALLOWED_VIDEO_DIR=

# ── Construction PPE Model ────────────────────────────────────
CONSTRUCTION_MODEL_PATH=Model/ppe.pt
CONSTRUCTION_DETECTION_CONFIDENCE=0.10
CONSTRUCTION_DEFAULT_CLASS_CONF=0.25
CONSTRUCTION_CLASS_CONF_THRESHOLDS=

# ── Medical PPE Model ─────────────────────────────────────────
MEDICAL_MODEL_PATH=Model/bestMedicalModel2.pt
MEDICAL_DETECTION_CONFIDENCE=0.15
MEDICAL_DEFAULT_CLASS_CONF=0.30
MEDICAL_CLASS_CONF_THRESHOLDS=

# ── Violation Frames Storage & Retention ──────────────────────
FRAMES_DIR=violation_frames
MAX_FRAME_AGE_DAYS=30
FRAME_CLEANUP_INTERVAL_HOURS=6.0

# ── Alert & Violation Timing (seconds) ────────────────────────
ALERT_COOLDOWN_SECONDS=60
VIOLATION_PERSIST_SECONDS=8
MEDICAL_VIOLATION_PERSIST_SECONDS=3
ALERT_DISPLAY_SECONDS=3.0

# ── Camera Loop & Stream Timing ───────────────────────────────
FRAME_READ_RETRY_DELAY_SECONDS=0.05
STREAM_FPS_DELAY_SECONDS=0.04

# ── Email Alerts (SMTP / Gmail App Password) ──────────────────
SENDER_EMAIL=
RECEIVER_EMAIL=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
ALERT_SMTP_TIMEOUT_SECONDS=10.0

# ── Webhook Alerts (Slack / Generic HTTP POST) ────────────────
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=10.0
