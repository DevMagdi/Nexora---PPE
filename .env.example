# Copy this file to .env for local development. For a production on-prem install,
# run: python scripts/setup_onprem.py --host <customer-hostname>
# That command creates a mode-0600 .env with unique secrets and a one-time admin password.

# ── Application & network ─────────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*
# Production pins Caddy inside the isolated edge network. The setup utility writes
# TRUSTED_PROXIES, EDGE_DOCKER_SUBNET, DATA_DOCKER_SUBNET and container IPs.
TRUSTED_PROXIES=
# EDGE_DOCKER_SUBNET=172.30.100.0/24
# DATA_DOCKER_SUBNET=172.30.101.0/24

# ── Database (development uses SQLite; production Compose uses PostgreSQL) ──
DATABASE_URL=sqlite+aiosqlite:///./ppe_detection.db
DB_SQL_ECHO=false
# Startup migrations fail with a clear log instead of waiting forever for a DB/DDL lock.
DB_MIGRATION_CONNECT_TIMEOUT_SECONDS=15
DB_MIGRATION_LOCK_TIMEOUT_MS=15000
# SQL Server local example (also run: pip install -r requirements/mssql.txt, and
# install "ODBC Driver 18 for SQL Server" from Microsoft on Windows):
# DATABASE_URL=mssql+aioodbc://USER:PASSWORD@HOST:1433/DBNAME?driver=ODBC+Driver+18+for+SQL+Server
# Set by scripts/setup_onprem.py for production:
# POSTGRES_USER=nexora
# POSTGRES_DB=ppe_detection
# POSTGRES_PASSWORD=

# ── Authentication ───────────────────────────────────────────────────
# Random development-only secrets are generated if omitted. Production requires
# these to be explicitly set; do not use values from this example.
# HS256 needs at least 32 random bytes — short values fail fast at startup with
# a clear error (previously: cryptic PyJWT InsecureKeyLengthWarning at login).
# Generate one with:  python scripts/gen_jwt_secret.py
# (Unset JWT_SECRET in dev keeps working: an ephemeral random key is used, but
# it changes on every reload and invalidates existing sessions.)
# JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240
MEDIA_TOKEN_EXPIRE_MINUTES=10
BOOTSTRAP_USERNAME=admin
# BOOTSTRAP_PASSWORD=
BOOTSTRAP_SECTOR=both
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── On-prem camera/video source allowlists ────────────────────────────
# Replace the example networks with only the camera VLAN/IP ranges at the site.
ALLOWED_RTSP_PREFIXES=rtsp://192.168.10.,rtsp://10.10.0.
# For development, set this to a dedicated local video directory if using files.
ALLOWED_VIDEO_DIR=./videos
# Production Compose sets this to /var/nexora/videos (mounted read-only).

# ── Encrypted database backup ─────────────────────────────────────────
# Production setup generates a 256-bit key. Keep a separate secure offline copy.
# BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups

# ── Construction PPE Model ────────────────────────────────────────────
CONSTRUCTION_MODEL_PATH=Model/ppe.pt
CONSTRUCTION_DETECTION_CONFIDENCE=0.25
CONSTRUCTION_DEFAULT_CLASS_CONF=0.35
CONSTRUCTION_CLASS_CONF_THRESHOLDS=

# ── Medical PPE Model ────────────────────────────────────────────────
MEDICAL_MODEL_PATH=Model/bestMedicalModel.pt
MEDICAL_DETECTION_CONFIDENCE=0.25
MEDICAL_DEFAULT_CLASS_CONF=0.35
MEDICAL_CLASS_CONF_THRESHOLDS=

# ── Detection precision floor ────────────────────────────────────────
DETECTION_CONFIDENCE_FLOOR=0.25

# ── Hybrid Detector ──────────────────────────────────────────────────
HYBRID_DETECTION_ENABLED=true
HYBRID_CONSTRUCTION_ON_MEDICAL=true
HYBRID_MEDICAL_ON_CONSTRUCTION=false
HYBRID_MERGE_IOU=0.55
HYBRID_CONFLICT_IOU=0.30
HYBRID_OVERRIDE_MIN_CONTAINMENT=0.45
HYBRID_HEAD_REGION_RATIO=0.32

# ── Skin precision filters ───────────────────────────────────────────
SKIN_FILTER_ENABLED=true
SKIN_BARE_HAND_ENABLED=true
SKIN_EYE_BRIDGE_ENABLED=true
SKIN_MIN_RATIO=0.18
SKIN_STRONG_RATIO=0.32
SKIN_GLOVE_REJECT_RATIO=0.24
SKIN_BARE_HAND_MIN_THICKNESS=0.12
SKIN_BARE_HAND_MIN_AREA=0.10
SKIN_EYE_BRIDGE_MIN_SKIN_RATIO=0.22
SKIN_GLASS_CONFIRM_MIN_RATIO=0.05
SKIN_SYNTHETIC_MIN_CONF=0.45
SKIN_SYNTHETIC_MAX_CONF=0.85
SKIN_NEGATIVE_MIN_CONF=0.70
SKIN_MIN_PERSON_CONF=0.35
SKIN_POSITIVE_OVERRIDE_MAX_CONF=0.60
SKIN_POSITIVE_OVERRIDE_MIN_CONF=0.70

# ── Violation frames storage & retention ─────────────────────────────
FRAMES_DIR=violation_frames
MAX_FRAME_AGE_DAYS=30
FRAME_CLEANUP_INTERVAL_HOURS=6.0

# ── Alert timing ─────────────────────────────────────────────────────
ALERT_COOLDOWN_SECONDS=60
VIOLATION_PERSIST_SECONDS=8
MEDICAL_VIOLATION_PERSIST_SECONDS=3
ALERT_DISPLAY_SECONDS=3.0

# ── Camera loop & stream timing ──────────────────────────────────────
FRAME_READ_RETRY_DELAY_SECONDS=0.05
STREAM_FPS_DELAY_SECONDS=0.04
CAMERA_FIRST_FRAME_TIMEOUT_SECONDS=10.0
CAMERA_FRAME_STALE_SECONDS=15.0

# ── Optional email alerts ────────────────────────────────────────────
SENDER_EMAIL=
RECEIVER_EMAIL=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
ALERT_SMTP_TIMEOUT_SECONDS=10.0

# ── Optional webhooks ────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=10.0
