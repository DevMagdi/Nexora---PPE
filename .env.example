# Local: cp .env.example .env. Generate permanent secrets before a pilot.
# On-prem production: python scripts/setup_onprem.py --host <site-host> --rtsp-prefix <camera-prefix>
APP_ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=*
TRUSTED_PROXIES=

DATABASE_URL=sqlite+aiosqlite:///./ppe_detection.db
DB_SQL_ECHO=false
DB_MIGRATION_CONNECT_TIMEOUT_SECONDS=15
DB_MIGRATION_LOCK_TIMEOUT_MS=15000
# SQL Server: install requirements/mssql.txt plus ODBC Driver 18 for SQL Server.
# DATABASE_URL=mssql+aioodbc://USER:PASSWORD@HOST:1433/DBNAME?driver=ODBC+Driver+18+for+SQL+Server
# DISABLE_SQLALCHEMY_CEXT=1

# Unset secrets use random development-only values. Set unique permanent values for a pilot.
# python scripts/gen_jwt_secret.py
# JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=240
MEDIA_TOKEN_EXPIRE_MINUTES=10
BOOTSTRAP_USERNAME=admin
# BOOTSTRAP_PASSWORD=
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Exact network allowlists: replace with the installation's camera VLANs.
ALLOWED_RTSP_PREFIXES=rtsp://192.168.10.,rtsp://10.10.0.
# HTTP(S) has an independent, default-closed policy. Include actual ports/path roots.
# Example only: http://192.168.10.30:8888/factory,https://camera.example/live
ALLOWED_HTTP_CAMERA_PREFIXES=
# Local USB and loopback HTTP are dev-only, explicit opt-ins; forbidden in staging/prod.
ENABLE_USB_SOURCES=false
ALLOWED_USB_DEVICE_INDICES=0
ALLOW_LOOPBACK_HTTP_SOURCES=false
ALLOWED_VIDEO_DIR=./videos
UPLOADS_DIR=./videos/uploads
MAX_UPLOAD_MB=100
MAX_IMAGE_PIXELS=24000000
MAX_UPLOAD_VIDEO_SECONDS=120

# The sole approved checkpoint: Model/ppe.pt. Install it separately; no auto-download.
# Any unified name (e.g. ppe_unified_best.pt) is rejected at startup.
PPE_MODEL_PATH=Model/ppe.pt
# Recommended SHA-256 pin for Model/ppe.pt (rejected if it does not match).
PPE_MODEL_SHA256=15c758c669eeb557d9439bd18c5a3929680238122a95286210ca69e11af8218a
DETECTION_CONFIDENCE=0.50
# Explicit negative evidence needs this threshold (>= 0.60) AND the persistence window.
DETECTION_NEGATIVE_CONFIDENCE=0.60

FRAMES_DIR=violation_frames
MAX_FRAME_AGE_DAYS=30
FRAME_CLEANUP_INTERVAL_HOURS=6.0
ALERT_COOLDOWN_SECONDS=60
VIOLATION_PERSIST_SECONDS=8
VIOLATION_PERSIST_FLOOR_SECONDS=8
ALERT_DISPLAY_SECONDS=3.0
FRAME_READ_RETRY_DELAY_SECONDS=0.05
STREAM_FPS_DELAY_SECONDS=0.04
RTSP_OPEN_TIMEOUT_SECONDS=10.0
RTSP_READ_TIMEOUT_SECONDS=5.0
HTTP_SOURCE_OPEN_TIMEOUT_SECONDS=10.0
HTTP_SOURCE_READ_TIMEOUT_SECONDS=10.0
CAMERA_MAX_READ_FAILURES=3
CAMERA_RECONNECT_ATTEMPTS=2
CAMERA_RECONNECT_DELAY_SECONDS=1.0
HLS_CACHE_MAX_MB=128
HLS_DECODE_FPS=5.0
USB_OPEN_TIMEOUT_SECONDS=5.0
USB_READ_TIMEOUT_SECONDS=3.0
CAMERA_CAPTURE_BUFFER_SIZE=1
CAMERA_FIRST_FRAME_TIMEOUT_SECONDS=10.0
CAMERA_FRAME_STALE_SECONDS=15.0

# Optional notification delivery.
SENDER_EMAIL=
RECEIVER_EMAIL=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
ALERT_SMTP_TIMEOUT_SECONDS=10.0
SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=10.0

# Production requires a separate, securely retained 256-bit encryption key.
# BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=backups
# Network/IP/POSTGRES values below are generated by scripts/setup_onprem.py.
